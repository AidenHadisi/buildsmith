{
  "name": "buildsmith",
  "version": "0.0.0",
  "description": "A lightweight agentic pipeline, enforced by a deterministic state machine over markdown on disk.",
  "keywords": [
    "agents",
    "bun",
    "cursor",
    "kanban",
    "spec-driven-development"
  ],
  "homepage": "https://github.com/AidenHadisi/buildsmith#readme",
  "bugs": {
    "url": "https://github.com/AidenHadisi/buildsmith/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Hadisi",
    "url": "https://github.com/AidenHadisi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidenHadisi/buildsmith.git"
  },
  "bin": {
    "buildsmith": "./src/main.ts"
  },
  "files": [
    "board/src/server/app.ts",
    "dist",
    "plugin",
    "prompts",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --parallel dev:board dev:server",
    "dev:board": "vite --config board/vite.config.ts",
    "dev:server": "bun --watch src/main.ts board --no-open --port 3000",
    "build": "vite build --config board/vite.config.ts",
    "prepack": "bun run build",
    "build:bin": "bun run build && bun build-bin.ts",
    "start": "bun src/main.ts board",
    "check": "oxlint && oxfmt --check",
    "lint": "oxlint .",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p board",
    "test": "bun test",
    "release": "bumpp"
  },
  "dependencies": {
    "citty": "0.2.2",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.7",
    "yaml": "2.9.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "bumpp": "12.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.45.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
