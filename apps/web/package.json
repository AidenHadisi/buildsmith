{
  "name": "@buildsmith/web",
  "version": "0.0.0",
  "private": true,
  "description": "Local task board and docs UI for Buildsmith.",
  "homepage": "https://github.com/AidenHadisi/buildsmith/tree/main/apps/web#readme",
  "bugs": {
    "url": "https://github.com/AidenHadisi/buildsmith/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Hadisi",
    "url": "https://github.com/AidenHadisi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidenHadisi/buildsmith.git",
    "directory": "apps/web"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@buildsmith/store": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "hono": "4.13.7",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
