{
  "name": "@buildsmith/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line interface for Buildsmith.",
  "homepage": "https://github.com/AidenHadisi/buildsmith/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/AidenHadisi/buildsmith/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Hadisi",
    "url": "https://github.com/AidenHadisi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidenHadisi/buildsmith.git",
    "directory": "packages/cli"
  },
  "bin": {
    "buildsmith": "./src/main.ts"
  },
  "files": [
    "dist",
    "plugin",
    "prompts",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "bun --watch src/main.ts board --no-open --port 3000",
    "build": "vite build --config web/vite.config.ts",
    "build:bin": "bun run build && bun scripts/build-bin.ts",
    "start": "bun src/main.ts board",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "@buildsmith/store": "workspace:*",
    "citty": "0.2.2",
    "hono": "4.13.7",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vite": "8.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
